<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng ký — TaskFlow</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <div class="auth-wrapper">
    <div class="form-card">

      <div class="brand">
        <div class="brand-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>
        <div>
          <div class="brand-name">TaskFlow</div>
          <div class="brand-sub">Enterprise Suite</div>
        </div>
      </div>

      <span class="badge">TẠO TÀI KHOẢN</span>
      <h2>Đăng ký</h2>
      <p class="subtitle">Điền thông tin để bắt đầu sử dụng</p>

      <% if (locals.error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form action="/api/auth/register" method="POST">
          <div class="field">
            <label for="fullName">Họ và tên</label>
            <input type="text" id="fullName" name="fullName"
              placeholder="Nhập họ và tên" required>
          </div>

        <div class="field">
          <label for="username">Tên đăng nhập</label>
          <input type="text" id="username" name="username"
            placeholder="username" required>
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email"
            placeholder="you@company.com" required>
        </div>

        <div class="field">
          <label for="password">Mật khẩu</label>
          <input type="password" id="password" name="password"
            placeholder="Tối thiểu 8 ký tự" required minlength="8">
          <div class="strength">
            <div class="bar" id="bar1"></div>
            <div class="bar" id="bar2"></div>
            <div class="bar" id="bar3"></div>
            <div class="bar" id="bar4"></div>
          </div>
          <div class="strength-label" id="strength-label">Nhập mật khẩu</div>
        </div>

        <button type="submit" class="btn-primary">Tạo tài khoản</button>

        <p class="terms">
          Bằng cách đăng ký, bạn đồng ý với
          <a href="/terms">Điều khoản dịch vụ</a> và
          <a href="/privacy">Chính sách bảo mật</a>.
        </p>
      </form>

      <div class="link-row">
        Đã có tài khoản? <a href="/auth/login">Đăng nhập</a>
      </div>

    </div>
  </div>

  <script>
    const pwd = document.getElementById('password');
    const bars = [1,2,3,4].map(i => document.getElementById('bar' + i));
    const label = document.getElementById('strength-label');
    const levels = ['', 'Yếu', 'Trung bình', 'Tốt', 'Mạnh'];
    const colors = ['', '#E24B4A', '#EF9F27', '#3B6D11', '#3B6D11'];

    pwd.addEventListener('input', () => {
      const v = pwd.value;
      let score = 0;
      if (v.length >= 8) score++;
      if (/[A-Z]/.test(v)) score++;
      if (/[0-9]/.test(v)) score++;
      if (/[^A-Za-z0-9]/.test(v)) score++;

      bars.forEach((bar, i) => {
        bar.style.background = i < score ? colors[score] : '#e0e0e0';
      });
      label.textContent = v ? 'Độ mạnh: ' + levels[score] : 'Nhập mật khẩu';
    });
  </script>
</body>
</html>