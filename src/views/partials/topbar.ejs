<div class="topbar" style="justify-content: space-between">
    <div style="display: flex; align-items: center; gap: 10px">
        <button class="hamburger-btn" onclick="openSidebar()" style="display: none; width: 34px; height: 34px; border-radius: 8px; border: 1px solid #e2e8f0; background: #fff; color: #334155; align-items: center; justify-content: center; cursor: pointer; font-size: 18px">
            <i class="ti ti-menu-2"></i>
        </button>
        <div>
            <div class="page-title"><%= pageTitle || title %></div>
            <div class="breadcrumb"><%= breadcrumb || '' %></div>
        </div>
    </div>

    <!-- ✅ Thêm display:flex; align-items:center; gap:8px -->
    <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0">
        <%- include('../partials/notif-bell') %>
        <button class="topbar-btn" title="Làm mới" onclick="location.reload()">
            <i class="ti ti-refresh"></i>
        </button>
        <button class="topbar-btn" title="Tùy chọn">
            <i class="ti ti-dots"></i>
        </button>
    </div>
</div>
