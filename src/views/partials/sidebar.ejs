<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />

<!-- Overlay mobile -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<aside class="sidebar open" id="sb">
    <div class="sb-header">
        <button class="sb-toggle" onclick="toggleSB()">
            <i class="ti ti-layout-sidebar" style="font-size: 18px"></i>
        </button>
        <span class="sb-logo">TaskFlow</span>
    </div>

    <nav class="sb-nav">
        <div class="nav-section">TỔNG QUAN</div>
        <a href="/api/tasks/dashboard" class="nav-item <%= page === 'dashboard' ? 'active' : '' %>">
            <span class="nav-icon"><i class="ti ti-layout-dashboard"></i></span>
            <span class="nav-label">Dashboard</span>
        </a>

        <div class="divider"></div>
        <div class="nav-section">QUẢN LÝ</div>

        <!-- Công việc — tất cả đều thấy -->
        <button class="nav-item" onclick="toggleSub('task-sub', 'task-chev')">
            <span class="nav-icon"><i class="ti ti-checklist"></i></span>
            <span class="nav-label">Công việc</span>
            <span class="nav-badge">5</span>
            <i class="ti ti-chevron-down chevron" id="task-chev"></i>
        </button>
        <div class="submenu <%= page === 'tasks' ? 'show' : '' %>" id="task-sub">
            <!-- Chỉ Manager+ mới thấy "Giao việc mới" -->
            <% if (['Admin','Manager'].includes(user.effectiveRole)) { %>
                <a href="/api/tasks/new" class="sub-item">Giao việc mới</a>
            <% } %>
            <a href="/api/tasks/list" class="sub-item <%= page === 'tasks' ? 'active' : '' %>">Danh sách công việc</a>
            <% if (['Admin','Manager'].includes(user.effectiveRole)) { %>
                <a href="/api/tasks?status=stuck" class="sub-item">Việc vướng mắc</a>
            <% } %>
            <a href="/api/tasks/progress" class="sub-item">Cập nhật tiến độ</a>
            <a href="/api/tasks/review" class="sub-item">Đánh giá & nghiệm thu</a>

        </div>

        <!-- Nhân sự — chỉ Manager+ -->
        <% if (['Admin','Manager'].includes(user.effectiveRole)) { %>
            <button class="nav-item" onclick="toggleSub('team-sub', 'team-chev')">
                <span class="nav-icon"><i class="ti ti-users"></i></span>
                <span class="nav-label">Nhân sự</span>
                <i class="ti ti-chevron-down chevron" id="team-chev"></i>
            </button>
            <div class="submenu" id="team-sub">
                <a href="/api/employees/list" class="sub-item <%= page === 'employees' ? 'active' : '' %>">Danh sách nhân viên</a>
                <a href="/api/employees/assign" class="sub-item">Phân công</a>
            </div>
        <% } %>

        <!-- Danh mục — chỉ Manager+ -->
        <% if (['Admin','Manager'].includes(user.effectiveRole)) { %>
            <button class="nav-item" onclick="toggleSub('category-sub', 'category-chev')">
                <span class="nav-icon"><i class="ti ti-tag"></i></span>
                <span class="nav-label">Danh mục</span>
                <i class="ti ti-chevron-down chevron" id="category-chev"></i>
            </button>
            <div class="submenu" id="category-sub">
                <a href="/api/categories/new-job" class="sub-item">Thêm công việc mới</a>
            </div>
        <% } %>

        <div class="divider"></div>
        <div class="nav-section">BÁO CÁO</div>
        
        <!-- Báo cáo — chỉ Manager+ -->
        <% if (['Admin','Manager'].includes(user.effectiveRole)) { %>
            <a href="/api/tasks/home" class="nav-item <%= page === 'stats' ? 'active' : '' %>">
                <span class="nav-icon"><i class="ti ti-chart-bar"></i></span>
                <span class="nav-label">Home</span>
            </a>
            <a href="/api/auth/test" class="nav-item">
                <span class="nav-icon"><i class="ti ti-file-analytics"></i></span>
                <span class="nav-label">Trang dùng để test</span>
            </a>
            
        <% } %>

        <div class="divider"></div>
        <!-- Cài đặt — chỉ Admin -->
        <% if (user.effectiveRole === 'Admin') { %>
            <a href="/api/tasks/settings" class="nav-item">
                <span class="nav-icon"><i class="ti ti-settings"></i></span>
                <span class="nav-label">Cài đặt</span>
            </a>
        <% } %>
    </nav>

    <div class="sb-footer">
        <div class="user-row">
            <div class="avatar"><%= user.fullName ? user.fullName.charAt(0).toUpperCase() : 'U' %></div>
            <div class="user-info">
                <div class="user-name"><%= user.fullName || user.username %></div>
                <div class="user-role"><%= user.role %></div>
            </div>
            <a href="/api/auth/logout" class="logout-btn" title="Đăng xuất">
                <i class="ti ti-logout"></i>
            </a>
        </div>
    </div>
</aside>

<script>
    const isMobile = () => window.innerWidth <= 768;

    // ── Toggle sidebar desktop ──────────────────
    function toggleSB() {
        const sb = document.getElementById("sb");
        if (isMobile()) {
            openSidebar();
        } else {
            sb.classList.toggle("open");
            if (!sb.classList.contains("open")) {
                document.querySelectorAll(".submenu").forEach((m) => m.classList.remove("show"));
                document.querySelectorAll(".chevron").forEach((c) => c.classList.remove("rotated"));
            }
        }
    }

    // ── Mobile: mở/đóng sidebar ────────────────
    function openSidebar() {
        document.getElementById("sb").classList.add("mobile-open");
        document.getElementById("sidebarOverlay").classList.add("show");
        document.body.style.overflow = "hidden"; // chặn scroll trang
    }

    function closeSidebar() {
        document.getElementById("sb").classList.remove("mobile-open");
        document.getElementById("sidebarOverlay").classList.remove("show");
        document.body.style.overflow = "";
    }

    // ── Submenu ─────────────────────────────────
    function toggleSub(menuId, chevId) {
        const sb = document.getElementById("sb");
        // Desktop: sidebar phải mở mới cho toggle submenu
        if (!isMobile() && !sb.classList.contains("open")) {
            sb.classList.add("open");
            return;
        }
        document.getElementById(menuId).classList.toggle("show");
        document.getElementById(chevId).classList.toggle("rotated");
    }

    // ── Đóng sidebar khi resize lên desktop ────
    window.addEventListener("resize", () => {
        if (!isMobile()) closeSidebar();
    });
</script>
