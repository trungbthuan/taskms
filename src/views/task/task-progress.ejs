<!DOCTYPE html>
<html lang="vi">

<head>
    <%- include('../partials/head') %>
    <style>
        /* Progress slider */
        .slider-wrap {
            position: relative;
            padding: 10px 0;
        }

        .slider {
            -webkit-appearance: none;
            width: 100%;
            height: 6px;
            border-radius: 4px;
            background: #E2E8F0;
            outline: none;
            cursor: pointer;
        }

        .slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #2563EB;
            cursor: pointer;
            border: 2px solid #fff;
            box-shadow: 0 1px 4px rgba(0, 0, 0, .2);
        }

        .slider::-moz-range-thumb {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #2563EB;
            cursor: pointer;
            border: 2px solid #fff;
        }

        /* Progress display */
        .progress-display {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 4px solid #2563EB;
            font-size: 20px;
            font-weight: 700;
            color: #2563EB;
            margin: 0 auto 16px;
            transition: all .2s;
        }

        /* Status options */
        .status-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .status-option {
            display: none;
        }

        .status-label {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 8px;
            border: 1.5px solid #E2E8F0;
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
            transition: all .15s;
        }

        .status-option:checked+.status-label {
            border-color: currentColor;
            background: #F8FAFC;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        /* Info card */
        .info-card {
            background: #F8FAFC;
            border-radius: 10px;
            border: 1px solid #E2E8F0;
            padding: 16px;
            margin-bottom: 20px;
        }

        .info-row {
            display: flex;
            gap: 8px;
            margin-bottom: 8px;
            font-size: 13px;
        }

        .info-row:last-child {
            margin: 0;
        }

        .info-label {
            color: #64748B;
            width: 120px;
            flex-shrink: 0;
        }

        .info-value {
            color: #0F172A;
            font-weight: 500;
        }

        /* Badge */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-pending {
            background: #F1F5F9;
            color: #475569;
        }

        .badge-progress {
            background: #EFF6FF;
            color: #1D4ED8;
        }

        .badge-completed {
            background: #EAF3DE;
            color: #27500A;
        }

        .badge-stuck {
            background: #FCEBEB;
            color: #A32D2D;
        }
    </style>
</head>

<body>
    <div class="app">
        <%- include('../partials/sidebar', { page: 'tasks', user: user }) %>

        <div class="main">
            <%- include('../partials/topbar', { pageTitle: 'Cập nhật tiến độ', breadcrumb: 'Công việc / Cập nhật tiến độ' }) %>

            <div class="content">
                <div style="max-width:580px; margin:0 auto">

                    <!-- Thông tin công việc -->
                    <div class="info-card">
                        <div style="font-size:15px; font-weight:600; color:#0F172A; margin-bottom:12px">
                            <i class="ti ti-clipboard-text" style="color:#2563EB; margin-right:6px"></i>
                            <%= task.title %>
                        </div>
                        <div class="info-row">
                            <span class="info-label"><i class="ti ti-user"></i> Thực hiện</span>
                            <span class="info-value"><%= task.assignee.name %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label"><i class="ti ti-users"></i> Quản lý</span>
                            <span class="info-value"><%= task.manager.name %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label"><i class="ti ti-calendar"></i> Hạn chót</span>
                            <span class="info-value" style="<%= new Date(task.deadline) < new Date() && task.status !== 'Completed' ? 'color:#EF4444' : '' %>">
                                <%= new Date(task.deadline).toLocaleDateString('vi-VN') %>
                                <% if (new Date(task.deadline) < new Date() && task.status !== 'Completed') { %>
                                <span style="font-size:11px; color:#EF4444">(Quá hạn)</span>
                                <% } %>
                            </span>
                        </div>
                        <div class="info-row">
                            <span class="info-label"><i class="ti ti-tag"></i> Trạng thái</span>
                            <span class="info-value">
                                <%
                                    const badgeClass =
                                    task.status === 'Pending'     ? 'badge-pending'   :
                                    task.status === 'In Progress' ? 'badge-progress'  :
                                    task.status === 'Completed'   ? 'badge-completed' : 'badge-stuck';
                                    const badgeLabel =
                                    task.status === 'Pending'     ? 'Chờ thực hiện'   :
                                    task.status === 'In Progress' ? 'Đang thực hiện'  :
                                    task.status === 'Completed'   ? 'Hoàn thành'      : 'Vướng mắc';
                                %>
                                <span class="badge <%= badgeClass %>"><%= badgeLabel %></span>
                            </span>
                        </div>
                        <% if (task.description) { %>
                        <div class="info-row">
                            <span class="info-label"><i class="ti ti-notes"></i> Mô tả</span>
                            <span class="info-value" style="color:#64748B"><%= task.description %></span>
                        </div>
                        <% } %>
                    </div>

                    <!-- Form cập nhật -->
                    <div style="background:#fff; border-radius:12px; border:1px solid #E2E8F0; padding:24px; box-shadow:0 1px 3px rgba(0,0,0,.06)">
                        <form action="/api/tasks/<%= task.id %>/progress" method="POST">

                            <!-- Vòng tròn % -->
                            <div class="progress-display" id="progressDisplay">
                                <%= task.progressPercent %>%
                            </div>

                            <!-- Slider -->
                            <div class="slider-wrap">
                                <input type="range" class="slider" id="progressSlider" name="progressPercent" min="0" max="100" step="5" value="<%= task.progressPercent %>">
                            </div>
                            <div style="display:flex; justify-content:space-between; font-size:11px; color:#94A3B8; margin-bottom:20px">
                                <span>0%</span>
                                <span>25%</span>
                                <span>50%</span>
                                <span>75%</span>
                                <span>100%</span>
                            </div>

                            <!-- Trạng thái -->
                            <div style="margin-bottom:20px">
                                <label style="display:block; font-size:13px; font-weight:600; color:#374151; margin-bottom:10px">
                                    Trạng thái
                                </label>
                                <div class="status-grid">
                                    <div>
                                        <input type="radio" name="status" value="Pending" id="s1" class="status-option" <%= task.status === 'Pending' ? 'checked' : '' %>>
                                        <label for="s1" class="status-label" style="color:#475569">
                                            <span class="status-dot" style="background:#94A3B8"></span> Chờ thực hiện
                                        </label>
                                    </div>
                                    <div>
                                        <input type="radio" name="status" value="In Progress" id="s2" class="status-option" <%= task.status === 'In Progress' ? 'checked' : '' %>>
                                        <label for="s2" class="status-label" style="color:#1D4ED8">
                                            <span class="status-dot" style="background:#2563EB"></span> Đang thực hiện
                                        </label>
                                    </div>
                                    <div>
                                        <input type="radio" name="status" value="Completed" id="s3" class="status-option" <%= task.status === 'Completed' ? 'checked' : '' %>>
                                        <label for="s3" class="status-label" style="color:#27500A">
                                            <span class="status-dot" style="background:#3B6D11"></span> Hoàn thành
                                        </label>
                                    </div>
                                    <div>
                                        <input type="radio" name="status" value="Stuck" id="s4" class="status-option" <%= task.status === 'Stuck' ? 'checked' : '' %>>
                                        <label for="s4" class="status-label" style="color:#A32D2D">
                                            <span class="status-dot" style="background:#EF4444"></span> Vướng mắc
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Buttons -->
                            <div class="flex justify-end gap-3 pt-2" style="display:flex; justify-content:flex-end; gap:10px">
                                <a href="/api/tasks/list" style="padding:9px 18px; font-size:13px; color:#64748B; border:1px solid #E2E8F0; border-radius:8px; text-decoration:none; display:inline-flex; align-items:center; gap:4px">
                                    Hủy
                                </a>
                                <button type="submit" style="padding:9px 20px; font-size:13px; font-weight:600; background:#2563EB; color:#fff; border:none; border-radius:8px; cursor:pointer; display:inline-flex; align-items:center; gap:6px">
                                    <i class="ti ti-device-floppy"></i> Lưu tiến độ
                                </button>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const slider = document.getElementById('progressSlider');
        const display = document.getElementById('progressDisplay');

        // Cập nhật hiển thị % khi kéo slider
        slider.addEventListener('input', function() {
            const val = Number(this.value);
            display.textContent = val + '%';

            // Đổi màu theo tiến độ
            if (val === 100) {
                display.style.borderColor = '#3B6D11';
                display.style.color = '#3B6D11';
            } else if (val >= 50) {
                display.style.borderColor = '#2563EB';
                display.style.color = '#2563EB';
            } else if (val > 0) {
                display.style.borderColor = '#D97706';
                display.style.color = '#D97706';
            } else {
                display.style.borderColor = '#94A3B8';
                display.style.color = '#94A3B8';
            }

            // Tự động chọn status theo %
            if (val === 100) {
                document.getElementById('s3').checked = true;
            } else if (val === 0) {
                document.getElementById('s1').checked = true;
            } else {
                document.getElementById('s2').checked = true;
            }
        });

        // Khởi tạo màu ban đầu
        slider.dispatchEvent(new Event('input'));
    </script>
</body>

</html>